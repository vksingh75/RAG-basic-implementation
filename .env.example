# RAG-basic-implementation environment — copy to .env and fill in secrets.
# See docs/CONTRACTS.md for the canonical env var list.

# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# Host is the compose service name "postgres".
DATABASE_URL=postgresql://rag:rag@postgres:5432/rag

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_children

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# --- LLM ---
LLM_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY is required for chat (user fills in).
GROQ_API_KEY=
# Optional alternate providers (only needed if LLM_MODEL is changed).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Ports ---
INGESTION_PORT=8002
CHAT_PORT=8001
RETRIEVAL_PORT=8003
RETRIEVAL_URL=http://retrieval:8003
FRONTEND_PORT=3000
